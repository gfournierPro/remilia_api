fn display_auth_status(auth: &AuthStatusResponse) {
    println!("\n════════════════════════════════════");
    println!("🔐 AUTH STATUS");
    println!("════════════════════════════════════");
    println!(
        "Authenticated: {}",
        if auth.authenticated { "✅ Yes" } else { "❌ No" }
    );

