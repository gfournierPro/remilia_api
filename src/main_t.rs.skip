    async fn poke_user(&self, username: &str) -> Result<PokeResponse> {
        #[derive(Debug, Serialize)]
        #[serde(rename_all = "camelCase")]
        struct PokeRequest {
            poke_username: String,
        }

        let request_body = PokeRequest {
            poke_username: username.to_string(),
        };

        let response = self
            .client
            .post("https://www.remilia.com/api/poke")
            .headers(self.build_headers_remilia())
            .json(&request_body)
            .send()
            .await?;

        let poke_response: PokeResponse = response.json().await?;
        Ok(poke_response)
    }

    async fn send_friend_request(&self, username: &str) -> Result<FriendsResponse> {
        #[derive(Debug, Serialize)]
        #[serde(rename_all = "camelCase")]
        struct FriendsRequest {
            friend_username: String,
        }

        let request_body = FriendsRequest {
            friend_username: username.to_string(),
        };

        let response = self
            .client
            .post("https://www.remilia.com/api/friends/request")
            .headers(self.build_headers_remilia())
            .json(&request_body)
            .send()
            .await?;

        let friends_response: FriendsResponse = response.json().await?;
        Ok(friends_response)
    }

    async fn get_friends_page(&self, page: u32, limit: u32) -> Result<FriendsListResponse> {
        let url = format!(
            "https://www.remilia.com/api/friends/list?page={}&limit={}",
            page, limit
        );

        let response = self
            .client
            .get(&url)
            .headers(self.build_headers_remilia())
            .send()
            .await?;

        let friends_list: FriendsListResponse = response.json().await?;
        Ok(friends_list)
    }

    async fn scrape_all_friends(&self, db_file: &str) -> Result<()> {
        println!("🔍 Scraping all friends from Remilia Jackson...\n");

        let db = FriendsDatabase::new(db_file);
        let limit = 50;
        let mut page = 1;
        let mut total_fetched = 0;
        let mut all_friends = Vec::new();

        loop {
            print!("📄 Fetching page {}... ", page);
            std::io::Write::flush(&mut std::io::stdout())?;

            let response = self.get_friends_page(page, limit).await?;

            let friends_count = response.friends.len();
            println!("✅ Got {} friends", friends_count);

            for friend in &response.friends {
                all_friends.push(friend.display_username.clone());
            }

            total_fetched += friends_count;

            if friends_count < limit as usize || total_fetched >= response.total as usize {
                break;
            }

            page += 1;
            tokio::time::sleep(Duration::from_millis(500)).await;
        }

        println!("\n📊 Total friends fetched: {}", total_fetched);
        println!("💾 Syncing with database...\n");

        let sync_stats = db.sync_with_friends(&all_friends)?;

        println!("✅ Database sync complete!");
        println!("   Initial count: {}", sync_stats.initial_count);
        println!("   Added: {} new users", sync_stats.added);
        println!("   Removed: {} unfriended users", sync_stats.removed);
        println!("   Final count: {}", sync_stats.final_count);

        Ok(())
    }

    async fn auto_poke_from_feed(&self, max_pokes: usize) -> Result<()> {
        println!("🤖 Auto-poking from feed activity...\n");

        let activities = self.get_feed_activity().await?;
        println!("📰 Found {} feed activities", activities.len());

        let mut poke_targets: Vec<String> = Vec::new();

        for activity in &activities {
            match activity {
                FeedActivity::Poke { from, .. } => {
                    if !poke_targets.contains(&from.username) {
                        poke_targets.push(from.username.clone());
                    }
                }
                FeedActivity::Friendship { users, .. } => {
                    for user in users {
                        if !poke_targets.contains(&user.username) {
                            poke_targets.push(user.username.clone());
                        }
                    }
                }
            }
        }

        println!("🎯 Found {} unique users to poke", poke_targets.len());

        let poke_count = std::cmp::min(max_pokes, poke_targets.len());
        let mut successful_pokes = 0;

        for username in poke_targets.iter().take(poke_count) {
            print!("👉 Poking {}... ", username);
            std::io::Write::flush(&mut std::io::stdout())?;

            match self.poke_user(username).await {
                Ok(response) => {
                    if response.success {
                        println!("✅");
                        successful_pokes += 1;
                    } else {
                        println!("❌ Failed");
                    }
                }
                Err(e) => println!("❌ Error: {}", e),
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        println!("\n✅ Poked {}/{} users successfully", successful_pokes, poke_count);
        Ok(())
    }

    async fn auto_poke_smart(
        &self,
        max_pokes: usize,
        exclude_usernames: Vec<String>,
    ) -> Result<()> {
        println!("🧠 Smart auto-poking (most active users)...\n");

        let activities = self.get_feed_activity().await?;
        println!("📰 Analyzing {} feed activities", activities.len());

        let mut user_activity_count: HashMap<String, usize> = HashMap::new();

        for activity in &activities {
            match activity {
                FeedActivity::Poke { from, .. } => {
                    *user_activity_count.entry(from.username.clone()).or_insert(0) += 1;
                }
                FeedActivity::Friendship { users, .. } => {
                    for user in users {
                        *user_activity_count.entry(user.username.clone()).or_insert(0) += 1;
                    }
                }
            }
        }

        let mut user_activity_vec: Vec<_> = user_activity_count.into_iter().collect();
        user_activity_vec.sort_by(|a, b| b.1.cmp(&a.1));

        let poke_targets: Vec<String> = user_activity_vec
            .iter()
            .filter(|(username, _)| !exclude_usernames.contains(username))
            .take(max_pokes)
            .map(|(username, _)| username.clone())
            .collect();

        println!("🎯 Top {} active users to poke", poke_targets.len());

        let mut successful_pokes = 0;

        for (i, username) in poke_targets.iter().enumerate() {
            let activity_count = user_activity_vec
                .iter()
                .find(|(u, _)| u == username)
                .map(|(_, c)| c)
                .unwrap_or(&0);

            print!(
                "👉 [{}/{}] Poking {} (activity: {})... ",
                i + 1,
                poke_targets.len(),
                username,
                activity_count
            );
            std::io::Write::flush(&mut std::io::stdout())?;

            match self.poke_user(username).await {
                Ok(response) => {
                    if response.success {
                        println!("✅");
                        successful_pokes += 1;
                    } else {
                        println!("❌ Failed");
                    }
                }
                Err(e) => println!("❌ Error: {}", e),
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        println!(
            "\n✅ Poked {}/{} users successfully",
            successful_pokes,
            poke_targets.len()
        );
        Ok(())
    }

    async fn auto_friends_from_feed(&self, max_friends: usize) -> Result<()> {
        println!("🤝 Auto-friending from feed activity...\n");

        let activities = self.get_feed_activity().await?;
        println!("📰 Found {} feed activities", activities.len());

        let mut friend_targets: Vec<String> = Vec::new();

        for activity in &activities {
            match activity {
                FeedActivity::Poke { from, .. } => {
                    if !friend_targets.contains(&from.username) {
                        friend_targets.push(from.username.clone());
                    }
                }
                FeedActivity::Friendship { users, .. } => {
                    for user in users {
                        if !friend_targets.contains(&user.username) {
                            friend_targets.push(user.username.clone());
                        }
                    }
                }
            }
        }

        println!("🎯 Found {} unique users to friend", friend_targets.len());

        let friend_count = std::cmp::min(max_friends, friend_targets.len());
        let mut successful_requests = 0;

        for username in friend_targets.iter().take(friend_count) {
            print!("🤝 Sending friend request to {}... ", username);
            std::io::Write::flush(&mut std::io::stdout())?;

            match self.send_friend_request(username).await {
                Ok(response) => {
                    if response.success {
                        println!("✅");
                        successful_requests += 1;
                    } else {
                        println!("❌ Failed");
                    }
                }
                Err(e) => println!("❌ Error: {}", e),
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        println!(
            "\n✅ Sent {}/{} friend requests successfully",
            successful_requests, friend_count
        );
        Ok(())
    }

    async fn auto_poke_from_db(&self, db_file: &str, max_count: usize) -> Result<()> {
        let db = FriendsDatabase::new(db_file);
        let pokeable_users = db.get_pokeable_users()?;

        if pokeable_users.is_empty() {
            println!("❌ No users ready to poke (24h cooldown)");
            return Ok(());
        }

        println!("🎯 Found {} pokeable users", pokeable_users.len());

        let poke_count = std::cmp::min(max_count, pokeable_users.len());
        let mut successful_pokes = 0;

        for (i, username) in pokeable_users.iter().take(poke_count).enumerate() {
            print!("👉 [{}/{}] Poking {}... ", i + 1, poke_count, username);
            std::io::Write::flush(&mut std::io::stdout())?;

            match self.poke_user(username).await {
                Ok(response) => {
                    if response.success {
                        println!("✅");
                        db.update_poke(username)?;
                        successful_pokes += 1;
                    } else {
                        println!("❌ Failed");
                    }
                }
                Err(e) => {
                    if let Some(cooldown_secs) = Self::extract_cooldown_seconds(&e.to_string()) {
                        println!("⏰ On cooldown ({} seconds)", cooldown_secs);
                        db.update_poke_with_cooldown(username, cooldown_secs)?;
                    } else {
                        println!("❌ Error: {}", e);
                    }
                }
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        println!("\n✅ Poked {}/{} users successfully", successful_pokes, poke_count);
        Ok(())
    }

    async fn auto_friend_request_from_db(&self, db_file: &str, max_count: usize) -> Result<()> {
        let db = FriendsDatabase::new(db_file);
        let users_for_friend_request = db.get_users_for_friend_request()?;

        if users_for_friend_request.is_empty() {
            println!("❌ No users need friend requests");
            return Ok(());
        }

        println!("🎯 Found {} users needing friend requests", users_for_friend_request.len());

        let request_count = std::cmp::min(max_count, users_for_friend_request.len());
        let mut successful_requests = 0;

        for (i, username) in users_for_friend_request.iter().take(request_count).enumerate() {
            print!(
                "🤝 [{}/{}] Sending friend request to {}... ",
                i + 1,
                request_count,
                username
            );
            std::io::Write::flush(&mut std::io::stdout())?;

            match self.send_friend_request(username).await {
                Ok(response) => {
                    if response.success {
                        println!("✅");
                        db.mark_friend_request_sent(username)?;
                        successful_requests += 1;
                    } else {
                        println!("❌ Failed");
                    }
                }
                Err(e) => println!("❌ Error: {}", e),
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        println!(
            "\n✅ Sent {}/{} friend requests successfully",
            successful_requests, request_count
        );
        Ok(())
    }

    async fn auto_engage_from_db_with_stats(
        &self,
        db_file: &str,
        stats: &WorkerStats,
    ) -> Result<(u64, u64)> {
        let db = FriendsDatabase::new(db_file);

        let pokeable_users = db.get_pokeable_users()?;
        let users_for_friend_request = db.get_users_for_friend_request()?;

        let mut pokes_done = 0u64;
        let mut friends_done = 0u64;

        if !pokeable_users.is_empty() {
            let username = &pokeable_users[0];

            match self.poke_user(username).await {
                Ok(response) => {
                    if response.success {
                        db.update_poke(username)?;
                        pokes_done = 1;
                    }
                }
                Err(e) => {
                    if let Some(cooldown_secs) = Self::extract_cooldown_seconds(&e.to_string()) {
                        db.update_poke_with_cooldown(username, cooldown_secs)?;
                    }
                }
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        if !users_for_friend_request.is_empty() {
            let username = &users_for_friend_request[0];

            match self.send_friend_request(username).await {
                Ok(response) => {
                    if response.success {
                        db.mark_friend_request_sent(username)?;
                        friends_done = 1;
                    }
                }
                Err(_) => {}
            }

            tokio::time::sleep(Duration::from_secs(2)).await;
        }

        Ok((pokes_done, friends_done))
    }

    fn extract_cooldown_seconds(err_msg: &str) -> Option<i64> {
        if let Some(start) = err_msg.find("for ") {
            if let Some(end) = err_msg[start + 4..].find('s') {
                return err_msg[start + 4..start + 4 + end].parse().ok();
            }
        }
        None
    }

    pub async fn update_theme_to_dark(&mut self) -> Result<UpdateThemeResponse> {
        let request_body = UpdateThemeRequest {
            theme: "dark".to_string(),
            color: 0,
            cover: "default".to_string(),
            pfp: ProfilePfp {
                project: "milady".to_string(),
                id: "0".to_string(),
            },
            display_name: "Your Name".to_string(),
            username: "your_username".to_string(),
        };

        let response = self
            .client
            .post("https://www.remilia.com/api/profile/update")
            .headers(self.build_headers_remilia())
            .json(&request_body)
            .send()
            .await?;

        let theme_response: UpdateThemeResponse = response.json().await?;
        Ok(theme_response)
    }
}

