fn display_poke_result(response: &PokeResponse, username: &str) {
    if response.success {
        println!("✅ Successfully poked ~{}!", username);
        println!("👉 They'll get a notification!");
    } else {
        println!("❌ Failed to poke ~{}", username);
    }
}

fn display_feed_activity(activities: &[FeedActivity]) {
    println!("\n📰 Recent Feed Activity ({} items)\n", activities.len());
    println!("{}", "=".repeat(80));

    for activity in activities {
        match activity {
            FeedActivity::Poke { from, to, .. } => {
                println!("👉 {} poked {}", from.username, to.username);
            }
            FeedActivity::Friendship { users, .. } => {
                let usernames: Vec<&str> = users.iter().map(|u| u.username.as_str()).collect();
                println!("🤝 {} became friends", usernames.join(" & "));
            }
        }
    }
}

fn extract_cooldown_from_error(error: &str) -> Option<u64> {
    if let Some(start) = error.find("for ") {
        if let Some(end) = error[start + 4..].find('s') {
            return error[start + 4..start + 4 + end].parse().ok();
        }
    }
    None
}

// ===== AUTO LOOPS =====

async fn auto_hunt_loop(client: &BeetleApiClient) -> Result<()> {
    loop {
        println!("🎯 Checking if hunt is available...");

        match client.get_cooldowns().await {
            Ok(cooldowns) => {
                if cooldowns.has_hunts_remaining() {
                    println!("✅ Hunt available! Attempting hunt...");

                    match client.beetle_hunt().await {
                        Ok(result) => display_hunt_result(&result),
                        Err(e) => println!("❌ Hunt failed: {}", e),
                    }
                } else {
                    let wait_time = cooldowns.time_until_hunt_reset();
                    println!("⏰ No hunts remaining. Waiting {} seconds...", wait_time);
                    tokio::time::sleep(Duration::from_secs(wait_time)).await;
                }
            }
            Err(e) => println!("❌ Failed to check cooldowns: {}", e),
        }

        tokio::time::sleep(Duration::from_secs(60)).await;
    }
}

async fn auto_catch_loop(client: &BeetleApiClient) -> Result<()> {
    loop {
        println!("🪲 Checking if beetle catch is ready...");

        match client.get_cooldowns().await {
            Ok(cooldowns) => {
                if cooldowns.can_beetle_catch() {
                    println!("✅ Catch ready! Attempting catch...");

                    match client.beetle_catch().await {
                        Ok(result) => {
                            display_catch_result(&result);

                            if let CatchBeetleApiResponse::Success { result, .. } = result {
                                let wait_time = result.cooldown_ms / 1000;
                                println!("⏰ Waiting {} seconds for next catch...", wait_time);
                                tokio::time::sleep(Duration::from_secs(wait_time)).await;
                            }
                        }
                        Err(e) => {
                            println!("❌ Catch failed: {}", e);
                            tokio::time::sleep(Duration::from_secs(60)).await;
                        }
                    }
                } else {
                    let wait_time = cooldowns.time_until_beetle_ready();
                    println!("⏰ Catch on cooldown. Waiting {} seconds...", wait_time);
                    tokio::time::sleep(Duration::from_secs(wait_time)).await;
                }
            }
            Err(e) => {
                println!("❌ Failed to check cooldowns: {}", e);
                tokio::time::sleep(Duration::from_secs(60)).await;
            }
        }
    }
}

async fn auto_claim_ubc_loop(client: &BeetleApiClient) -> Result<()> {
    loop {
        println!("🧀 Checking if UBC claim is ready...");

        match client.get_cooldowns().await {
            Ok(cooldowns) => {
                if cooldowns.can_claim_ubc() {
                    println!("✅ UBC ready! Claiming cheese...");

                    match client.claim_ubc().await {
                        Ok(result) => {
                            display_claim_ubc_result(&result);
                            println!("⏰ Waiting 24 hours for next claim...");
                            tokio::time::sleep(Duration::from_secs(86400)).await;
                        }
                        Err(e) => {
                            println!("❌ Claim failed: {}", e);
                            tokio::time::sleep(Duration::from_secs(3600)).await;
                        }
                    }
                } else {
                    let wait_time = cooldowns.time_until_ubc_ready();
                    println!("⏰ UBC on cooldown. Waiting {} seconds...", wait_time);
                    tokio::time::sleep(Duration::from_secs(wait_time)).await;
                }
            }
            Err(e) => {
                println!("❌ Failed to check cooldowns: {}", e);
                tokio::time::sleep(Duration::from_secs(600)).await;
            }
        }
    }
}

// ===== WORKER STATS =====

#[derive(Clone)]
struct WorkerStats {
    beetle_catches_total: Arc<AtomicU64>,
    beetle_catches_session: Arc<AtomicU64>,
    cheese_claims_total: Arc<AtomicU64>,
    cheese_claims_session: Arc<AtomicU64>,
    pokes_total: Arc<AtomicU64>,
    pokes_session: Arc<AtomicU64>,
    friend_requests_total: Arc<AtomicU64>,
    friend_requests_session: Arc<AtomicU64>,
    last_beetle_catch: Arc<Mutex<Option<String>>>,
    last_cheese_claim: Arc<Mutex<Option<u64>>>,
    last_poke: Arc<Mutex<Option<String>>>,
    last_friend_request: Arc<Mutex<Option<String>>>,
    session_inventory: Arc<Mutex<SessionBeetleInventory>>,
}

impl WorkerStats {
    fn new() -> Self {
        Self {
            beetle_catches_total: Arc::new(AtomicU64::new(0)),
            beetle_catches_session: Arc::new(AtomicU64::new(0)),
            cheese_claims_total: Arc::new(AtomicU64::new(0)),
            cheese_claims_session: Arc::new(AtomicU64::new(0)),
            pokes_total: Arc::new(AtomicU64::new(0)),
            pokes_session: Arc::new(AtomicU64::new(0)),
            friend_requests_total: Arc::new(AtomicU64::new(0)),
            friend_requests_session: Arc::new(AtomicU64::new(0)),
            last_beetle_catch: Arc::new(Mutex::new(None)),
            last_cheese_claim: Arc::new(Mutex::new(None)),
            last_poke: Arc::new(Mutex::new(None)),
            last_friend_request: Arc::new(Mutex::new(None)),
            session_inventory: Arc::new(Mutex::new(SessionBeetleInventory::default())),
        }
    }

    fn record_beetle_catch(&self, beetle_name: String) {
        self.beetle_catches_total.fetch_add(1, Ordering::SeqCst);
        self.beetle_catches_session.fetch_add(1, Ordering::SeqCst);
        *self.last_beetle_catch.lock().unwrap() = Some(beetle_name);
    }

    fn record_cheese_claim(&self, amount: u64) {
        self.cheese_claims_total.fetch_add(1, Ordering::SeqCst);
        self.cheese_claims_session.fetch_add(1, Ordering::SeqCst);
        *self.last_cheese_claim.lock().unwrap() = Some(amount);
    }

    fn record_poke(&self, username: String) {
        self.pokes_total.fetch_add(1, Ordering::SeqCst);
        self.pokes_session.fetch_add(1, Ordering::SeqCst);
        *self.last_poke.lock().unwrap() = Some(username);
    }

    fn record_friend_request(&self, username: String) {
        self.friend_requests_total.fetch_add(1, Ordering::SeqCst);
        self.friend_requests_session.fetch_add(1, Ordering::SeqCst);
        *self.last_friend_request.lock().unwrap() = Some(username);
    }

    fn update_inventory(&self, new_inventory: BeetleInventory) {
        let mut inventory = self.session_inventory.lock().unwrap();
        inventory.update(new_inventory);
    }
}

// ===== WORKER FUNCTIONS =====

async fn beetle_auto_claim_worker(client: Arc<BeetleApiClient>, stats: WorkerStats) -> Result<()> {
    let mut interval = interval(Duration::from_secs(30));

    loop {
        interval.tick().await;
        println!("🪲 Checking for beetle catch...");

        match client.get_cooldowns().await {
            Ok(cooldowns) => {
                if cooldowns.can_beetle_catch() {
                    match client.beetle_catch().await {
                        Ok(CatchBeetleApiResponse::Success { success, result, user }) => {
                            stats.record_beetle_catch(result.beetle_name.clone());
                            stats.update_inventory(user.inventory);
                        }
                        Ok(CatchBeetleApiResponse::Error { .. }) => {}
                        Err(_) => {}
                    }
                }
            }
            Err(_) => {}
        }
    }
}

async fn cheese_auto_claim_worker(client: Arc<BeetleApiClient>, stats: WorkerStats) -> Result<()> {
    let mut interval = interval(Duration::from_secs(3600));

    loop {
        interval.tick().await;
        println!("🧀 Checking for UBC claim...");

        match client.get_cooldowns().await {
            Ok(cooldowns) => {
                if cooldowns.can_claim_ubc() {
                    match client.claim_ubc().await {
                        Ok(ClaimUBCApiResponse::Success { success, result, user }) => {
                            stats.record_cheese_claim(result.cheese as u64);
                        }
                        Ok(ClaimUBCApiResponse::Error { .. }) => {}
                        Err(_) => {}
                    }
                }
            }
            Err(_) => {}
        }
    }
}

async fn daily_poke_worker(client: Arc<BeetleApiClient>, stats: WorkerStats) -> Result<()> {
    let mut interval = interval(Duration::from_secs(300));
    let db_file = "friends_db.json";
    
    loop {
        interval.tick().await;
        println!("👉 Checking for daily poke...");

        let _ = client.auto_engage_from_db_with_stats(db_file, &stats).await;
    }
}

async fn status_dashboard_worker(stats: WorkerStats, client: Arc<BeetleApiClient>) -> Result<()> {
    let mut interval = interval(Duration::from_secs(10));

    loop {
        interval.tick().await;

        print!("\x1B[2J\x1B[1;1H");

        println!("╔════════════════════════════════════════════════════════════╗");
        println!("║         🤖 BEETLE HUNT BOT - WORKER DASHBOARD             ║");
        println!("╚════════════════════════════════════════════════════════════╝");

        println!("\n📊 SESSION STATISTICS");
        println!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
        println!(
            "🪲 Beetle Catches: {} (session: {})",
            stats.beetle_catches_total.load(Ordering::SeqCst),
            stats.beetle_catches_session.load(Ordering::SeqCst)
        );
        println!(
            "🧀 Cheese Claims:  {} (session: {})",
            stats.cheese_claims_total.load(Ordering::SeqCst),
            stats.cheese_claims_session.load(Ordering::SeqCst)
        );
        println!(
            "👉 Pokes:          {} (session: {})",
            stats.pokes_total.load(Ordering::SeqCst),
            stats.pokes_session.load(Ordering::SeqCst)
        );
        println!(
            "🤝 Friend Reqs:    {} (session: {})",
            stats.friend_requests_total.load(Ordering::SeqCst),
            stats.friend_requests_session.load(Ordering::SeqCst)
        );

        if let Ok(user) = client.get_beetle_user().await {
            println!("\n💰 CURRENT RESOURCES");
            println!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            println!("Level: {} | XP: {} | Cheese: {} 🧀", user.level, user.xp, user.cheese);
            println!("Total Beetles: {}", user.total_beetles());
        }

        println!("\n⌨️  Press Ctrl+C to stop all workers");
    }
}

async fn run_all_workers(client: BeetleApiClient) -> Result<()> {
    println!("🤖 ===== STARTING ALL WORKERS =====\n");

    let client = Arc::new(client);
    let stats = WorkerStats::new();

    let stats_clone = stats.clone();
    let client_clone = client.clone();
    let dashboard_handle = tokio::spawn(async move {
        status_dashboard_worker(stats_clone, client_clone).await
    });

    let stats_clone = stats.clone();
    let client_clone = client.clone();
    let beetle_handle = tokio::spawn(async move {
        beetle_auto_claim_worker(client_clone, stats_clone).await
    });

    let stats_clone = stats.clone();
    let client_clone = client.clone();
    let cheese_handle = tokio::spawn(async move {
        cheese_auto_claim_worker(client_clone, stats_clone).await
    });

    let stats_clone = stats.clone();
    let client_clone = client.clone();
    let poke_handle = tokio::spawn(async move {
        daily_poke_worker(client_clone, stats_clone).await
    });

    tokio::select! {
        _ = signal::ctrl_c() => {
            println!("\n\n🛑 Shutting down all workers...");
        }
        _ = dashboard_handle => {}
        _ = beetle_handle => {}
        _ = cheese_handle => {}
        _ = poke_handle => {}
    }

    Ok(())
}

#[tokio::main]
async fn main() -> Result<()> {
    println!("🚀 Beetle Hunt Bot Starting...\n");

    let token = load_auth_token()?;
    let (profile_sid, beetle_sid) = load_remilia_cookies()?;
    let mut client = BeetleApiClient::new(&token, &profile_sid, &beetle_sid)?;

    display_menu();

    let mut input = String::new();
    std::io::stdin().read_line(&mut input)?;
    let choice: u32 = input.trim().parse().unwrap_or(1);

    match choice {
        1 => {
            let cooldowns = client.get_cooldowns().await?;
            display_cooldowns(&cooldowns);
        }
        2 => {
            let result = client.beetle_catch().await?;
            display_catch_result(&result);
        }
        3 => {
            let result = client.beetle_hunt().await?;
            display_hunt_result(&result);
        }
        4 => {
            auto_catch_loop(&client).await?;
        }
        5 => {
            auto_hunt_loop(&client).await?;
        }
        6 => {
            let auth = client.get_auth_status().await?;
            display_auth_status(&auth);
        }
        7 => {
            print!("Enter your username: ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut username = String::new();
            std::io::stdin().read_line(&mut username)?;
            let username = username.trim();

            let profile = client.get_profile(username).await?;
            display_profile(&profile);
        }
        8 => {
            print!("Enter username to view: ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut username = String::new();
            std::io::stdin().read_line(&mut username)?;
            let username = username.trim();

            let profile = client.get_profile(username).await?;
            display_profile(&profile);
        }
        9 => {
            print!("Enter username to poke: ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut username = String::new();
            std::io::stdin().read_line(&mut username)?;
            let username = username.trim();

            let result = client.poke_user(username).await?;
            display_poke_result(&result, username);
        }
        10 => {
            let activities = client.get_feed_activity().await?;
            display_feed_activity(&activities);
        }
        11 => {
            print!("How many users to poke? (default 5): ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut count_input = String::new();
            std::io::stdin().read_line(&mut count_input)?;
            let max_pokes = count_input.trim().parse().unwrap_or(5);

            client.auto_poke_from_feed(max_pokes).await?;
        }
        12 => {
            print!("How many users to poke? (default 5): ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut count_input = String::new();
            std::io::stdin().read_line(&mut count_input)?;
            let max_pokes = count_input.trim().parse().unwrap_or(5);

            client.auto_poke_smart(max_pokes, vec![]).await?;
        }
        13 => {
            print!("How many friend requests to send? (default 5): ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut count_input = String::new();
            std::io::stdin().read_line(&mut count_input)?;
            let max_friends = count_input.trim().parse().unwrap_or(5);

            client.auto_friends_from_feed(max_friends).await?;
        }
        14 => {
            auto_claim_ubc_loop(&client).await?;
        }
        15 => {
            let db_file = "friends_db.json";
            client.scrape_all_friends(db_file).await?;
        }
        16 => {
            let db_file = "friends_db.json";
            let db = FriendsDatabase::new(db_file);
            let stats = db.get_stats()?;

            println!("\n📊 DATABASE STATISTICS");
            println!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            println!("Total users: {}", stats.total_users);
            println!("Poked at least once: {}", stats.poked_at_least_once);
            println!("Pokeable now: {}", stats.pokeable_now);
            println!("Friend requests sent: {}", stats.friend_requests_sent);
            println!("Need friend request: {}", stats.need_friend_request);
        }
        17 => {
            let db_file = "friends_db.json";
            let db = FriendsDatabase::new(db_file);
            let stats = db.get_stats()?;

            println!("\n📊 ENHANCED DATABASE STATISTICS");
            println!("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━");
            println!("Total users: {}", stats.total_users);
            println!("Poked at least once: {}", stats.poked_at_least_once);
            println!("Pokeable now: {}", stats.pokeable_now);
            println!("Friend requests sent: {}", stats.friend_requests_sent);
            println!("Need friend request: {}", stats.need_friend_request);

            if let Some(next_user) = db.get_next_pokeable_user()? {
                println!("\n⏰ Next pokeable user:");
                println!("   Username: {}", next_user.username);
                println!(
                    "   Time until pokeable: {}",
                    format_duration(next_user.time_until_pokeable)
                );
            }
        }
        18 => {
            print!("How many users to poke? (default 10): ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut count_input = String::new();
            std::io::stdin().read_line(&mut count_input)?;
            let max_count = count_input.trim().parse().unwrap_or(10);

            let db_file = "friends_db.json";
            client.auto_poke_from_db(db_file, max_count).await?;
        }
        19 => {
            print!("How many friend requests to send? (default 10): ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut count_input = String::new();
            std::io::stdin().read_line(&mut count_input)?;
            let max_count = count_input.trim().parse().unwrap_or(10);

            let db_file = "friends_db.json";
            client.auto_friend_request_from_db(db_file, max_count).await?;
        }
        20 => {
            print!("How many users to engage (poke + friend)? (default 10): ");
            std::io::Write::flush(&mut std::io::stdout())?;
            let mut count_input = String::new();
            std::io::stdin().read_line(&mut count_input)?;
            let max_count = count_input.trim().parse().unwrap_or(10);

            let db_file = "friends_db.json";
            let stats = WorkerStats::new();

            for i in 0..max_count {
                print!("[{}/{}] Engaging... ", i + 1, max_count);
                std::io::Write::flush(&mut std::io::stdout())?;

                match client.auto_engage_from_db_with_stats(db_file, &stats).await {
                    Ok((pokes, friends)) => {
                        println!("✅ (Pokes: {}, Friends: {})", pokes, friends);
                    }
                    Err(e) => println!("❌ Error: {}", e),
                }

                tokio::time::sleep(Duration::from_secs(3)).await;
            }
        }
        21 => {
            run_all_workers(client).await?;
        }
        22 => {
            let user = client.get_beetle_user().await?;
            println!("\n🧀 Cheese Count: {}", user.cheese);
            display_beetle_user(&user);
        }
        23 => {
            println!("🌙 Updating theme to dark mode...");
            let result = client.update_theme_to_dark().await?;
            if result.success {
                println!("✅ Theme updated successfully!");
            } else {
                println!("❌ Theme update failed");
            }
        }
        _ => {
            println!("❌ Invalid option");
        }
    }

    Ok(())
}

