        println!("\n👤 User Info:");
        println!("Username: ~{}", user.username);
        println!("Display Name: {}", user.display_name);
        println!("Pokes: {}", user.pokes);
        println!("Page Views: {}", user.page_views);
        println!("Friends: {}", user.friend_count);
    } else {
        println!("\n❌ Not authenticated");
